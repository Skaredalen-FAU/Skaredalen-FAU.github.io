---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formaterDato, hentForsidesaker, hentSide } from '../lib/innhold';

const forside = await hentSide('forside');
const { Content } = await render(forside);
const { facebook, epost } = (await hentSide('kontakt')).data;
const saker = await Promise.all(
  (await hentForsidesaker()).map(async (sak) => ({ sak, Tekst: (await render(sak)).Content })),
);
const innspill = await hentSide('innspill');
const { Content: InnspillTekst } = await render(innspill);
const innspillLenke = epost && `mailto:${epost}?subject=${encodeURIComponent('Innspill til FAU-møtet')}`;

const snarveier = [
  { href: '/arbeidsgrupper/', tittel: 'Arbeidsgrupper', tekst: 'Se hva vi jobber med, og hvem du kan kontakte' },
  { href: '/moter/', tittel: 'Møter', tekst: 'Neste møte, innkallinger og referater' },
  { href: '/smarttelefonfri-skole/', tittel: 'Smarttelefonfri skole', tekst: 'Les og last ned veilederen vår' },
  { href: '/om/kontakt/', tittel: 'Kontakt oss', tekst: 'Spørsmål, innspill eller lyst til å bidra' },
];
---

<Base beskrivelse={forside.data.ingress}>
  <section class="hero">
    {
      forside.data.bilde && (
        <img src={forside.data.bilde} alt="Akvarell av Skåredalen skole" width="1774" height="887" />
      )
    }
    <div class="ramme hero-tekst">
      <h1>{forside.data.tittel}</h1>
      {forside.data.ingress && <p>{forside.data.ingress}</p>}
    </div>
  </section>

  <div class="ramme side">
    {
      facebook && (
        <section class="boks">
          <h2>Er du ny i FAU dette skoleåret?</h2>
          <p>Bli med i Facebook-gruppen vår for å få møteinnkallinger og referater.</p>
          <p>
            <a class="knapp" href={facebook} rel="noopener">
              Gå til Facebook-gruppen
            </a>
          </p>
        </section>
      )
    }

    {
      saker.length > 0 && (
        <section class="forsidesaker" aria-labelledby="nytt-fra-fau">
          <h2 id="nytt-fra-fau">Nytt fra FAU</h2>
          {saker.map(({ sak, Tekst }) => (
            <article class="forsidesak">
              {sak.data.bilde && (
                <img src={sak.data.bilde} alt={sak.data.bilde_tekst ?? ''} loading="lazy" />
              )}
              <div class="forsidesak-tekst">
                <p class="forsidesak-dato">{formaterDato(sak.data.dato).replace(/^\S+ /, '')}</p>
                <h3>{sak.data.tittel}</h3>
                <Tekst />
                {sak.data.lenke && (
                  <p>
                    <a href={sak.data.lenke}>{sak.data.lenketekst ?? 'Les mer'} →</a>
                  </p>
                )}
              </div>
            </article>
          ))}
        </section>
      )
    }

    {
      innspill.data.vis && (
        <section class="boks">
          <h2>{innspill.data.tittel}</h2>
          <InnspillTekst />
          {innspillLenke && (
            <p>
              <a class="knapp" href={innspillLenke}>
                Send innspill på e-post
              </a>
            </p>
          )}
          {facebook && <p>Du kan også gi innspill i Facebook-gruppen.</p>}
        </section>
      )
    }

    <div class="tekst">
      <Content />
    </div>

    <nav class="snarveier" aria-label="Snarveier">
      {
        snarveier.map((snarvei) => (
          <a class="snarvei" href={snarvei.href}>
            <strong>{snarvei.tittel}</strong>
            <span>{snarvei.tekst}</span>
          </a>
        ))
      }
    </nav>
  </div>
</Base>
