---
import { render } from 'astro:content';
import Side from '../../layouts/Side.astro';
import { hentSide } from '../../lib/innhold';

const side = await hentSide('vedtekter');
const { Content } = await render(side);
---

<Side tittel={side.data.tittel} ingress={side.data.ingress} tilbake={{ href: '/om/', tekst: 'Om FAU' }}>
  <div class="tekst">
    <Content />
  </div>
</Side>
