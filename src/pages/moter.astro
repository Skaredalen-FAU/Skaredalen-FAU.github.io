---
import { render } from 'astro:content';
import Side from '../layouts/Side.astro';
import { formaterDato, hentSide } from '../lib/innhold';

const side = await hentSide('moter');
const { Content } = await render(side);
const { neste_mote, klokkeslett, sted, oppmote_skjema, oppmote_apner } = side.data;
const apnerKl = oppmote_apner ?? '19:00';
const detaljer = [klokkeslett && `Kl. ${klokkeslett}`, sted].filter(Boolean).join(' · ');
const { facebook } = (await hentSide('kontakt')).data;
---

<Side tittel={side.data.tittel} ingress={side.data.ingress}>
  <section class="neste-mote">
    <h2>Neste møte</h2>
    {
      neste_mote ? (
        <div data-dato={neste_mote.toISOString().slice(0, 10)}>
          <p class="dato">{formaterDato(neste_mote)}</p>
          {detaljer && <p class="detaljer">{detaljer}</p>}
          {oppmote_skjema && (
            <p class="oppmote" hidden data-skjema={oppmote_skjema} data-apner={apnerKl}>
              <a class="knapp knapp-oppmote" aria-disabled="true">
                Registrer oppmøte
              </a>
              <span class="oppmote-info">Åpner kl. {apnerKl.replace(':', '.')}.</span>
            </p>
          )}
        </div>
      ) : (
        <p class="dato">Dato kommer</p>
      )
    }
  </section>

  {
    facebook && (
      <section class="boks">
        <h2>Møteinnkalling og referater</h2>
        <p>
          Møteinnkallinger med tid og sted, og referater fra møtene, deles i Facebook-gruppen vår. Gruppen er lukket og er
          for foreldre og foresatte ved skolen. Er du ikke medlem ennå, kan du be om å bli med via lenken. Har du ikke
          Facebook? Ta kontakt med oss, så sender vi deg det du trenger.
        </p>
        <p>
          <a class="knapp" href={facebook} rel="noopener">
            Gå til Facebook-gruppen
          </a>
        </p>
      </section>
    )
  }

  <div class="tekst">
    <Content />
  </div>
</Side>

<script is:inline>
  // Siden bygges bare når noe endres, så en passert møtedato skjules i nettleseren.
  (() => {
    const boks = document.querySelector('[data-dato]');
    if (!boks) return;
    const slutt = new Date(boks.dataset.dato + 'T23:59:59');
    if (slutt < new Date()) boks.innerHTML = '<p class="dato">Dato kommer</p>';

    // Oppmøteknappen vises fra møtedagen og åpnes på valgt klokkeslett, uansett tidssonen på enheten.
    const oppmote = boks.querySelector('.oppmote');
    if (!oppmote) return;
    const knapp = oppmote.querySelector('a');
    const info = oppmote.querySelector('.oppmote-info');
    const oppdater = () => {
      const naa = new Date().toLocaleString('sv-SE', { timeZone: 'Europe/Oslo' });
      const dato = boks.dataset.dato;
      if (naa.slice(0, 10) !== dato) {
        oppmote.hidden = true;
        return false;
      }
      oppmote.hidden = false;
      if (naa.slice(11, 16) < oppmote.dataset.apner) return false;
      knapp.href = oppmote.dataset.skjema;
      knapp.rel = 'noopener';
      knapp.removeAttribute('aria-disabled');
      info.hidden = true;
      return true;
    };
    if (!oppdater()) {
      const tidtaker = setInterval(() => {
        if (oppdater()) clearInterval(tidtaker);
      }, 15000);
    }
  })();
</script>
