---
import Side from '../../layouts/Side.astro';
import { erAvsluttet, hentArbeidsgrupper, lesStatus } from '../../lib/innhold';

const grupper = await hentArbeidsgrupper();
const aktive = grupper.filter((gruppe) => !erAvsluttet(gruppe.data.status));
const avsluttede = grupper.filter((gruppe) => erAvsluttet(gruppe.data.status));
---

<Side
  tittel="Arbeidsgrupper"
  ingress="Arbeidet i FAU er organisert i arbeidsgrupper. Her ser du hva vi jobber med akkurat nå."
>
  <div class="boks">
    <p>
      <strong>FAU er for alle som vil bidra.</strong> Du trenger ikke være klassekontakt for å bli med i en arbeidsgruppe
      eller foreslå en ny sak. <a href="/om/kontakt/">Ta kontakt med oss</a>.
    </p>
  </div>

  <ul class="kortliste">
    {
      aktive.map((gruppe) => (
        <li>
          <article class="kort">
            <span class:list={['merke', lesStatus(gruppe.data.status).klasse]}>{lesStatus(gruppe.data.status).navn}</span>
            <h2>
              <a href={gruppe.data.lenke ?? `/arbeidsgrupper/${gruppe.id}/`}>{gruppe.data.navn}</a>
            </h2>
            {gruppe.data.kort && <p>{gruppe.data.kort}</p>}
            <p class="kontakt">
              {gruppe.data.kontaktperson ? (
                <>Kontaktperson: {gruppe.data.kontaktperson}</>
              ) : (
                <>Interessert i å bidra? Ta kontakt med FAU.</>
              )}
            </p>
          </article>
        </li>
      ))
    }
  </ul>

  {
    avsluttede.length > 0 && (
      <>
        <h2>Avsluttede saker</h2>
        <ul class="kortliste">
          {avsluttede.map((gruppe) => (
            <li>
              <article class="kort">
                <span class="merke avsluttet">Avsluttet</span>
                <h3>
                  <a href={gruppe.data.lenke ?? `/arbeidsgrupper/${gruppe.id}/`}>{gruppe.data.navn}</a>
                </h3>
                {gruppe.data.kort && <p>{gruppe.data.kort}</p>}
              </article>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Side>
