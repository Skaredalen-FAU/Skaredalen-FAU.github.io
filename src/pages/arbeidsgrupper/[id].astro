---
import { render } from 'astro:content';
import Side from '../../layouts/Side.astro';
import { erAvsluttet, hentArbeidsgrupper, lesStatus } from '../../lib/innhold';

export async function getStaticPaths() {
  const grupper = await hentArbeidsgrupper();
  // Grupper med egen lenke har ingen gruppeside; kortet peker rett til lenken.
  return grupper.filter((gruppe) => !gruppe.data.lenke).map((gruppe) => ({ params: { id: gruppe.id }, props: { gruppe } }));
}

const { gruppe } = Astro.props;
const { Content } = await render(gruppe);
const avsluttet = erAvsluttet(gruppe.data.status);
const status = lesStatus(gruppe.data.status);
---

<Side
  tittel={gruppe.data.navn}
  ingress={gruppe.data.kort}
  tilbake={{ href: '/arbeidsgrupper/', tekst: 'Alle arbeidsgrupper' }}
>
  <p><span class:list={['merke', status.klasse]}>{status.navn}</span></p>

  {
    avsluttet ? (
      <div class="boks">
        <p>
          {status.navn === 'Ferdig' ? 'Dette prosjektet er gjennomført.' : 'Denne saken er avsluttet.'} Har du spørsmål om
          arbeidet? <a href="/om/kontakt/">Ta kontakt med FAU</a>.
        </p>
      </div>
    ) : (
      <div class="boks">
        {gruppe.data.kontaktperson ? (
          <p>
            <strong>Kontaktperson:</strong> {gruppe.data.kontaktperson}
            <br />
            Vil du bidra eller har du innspill? <a href="/om/kontakt/">Ta kontakt via FAU</a>.
          </p>
        ) : (
          <p>
            <strong>Interessert i å bidra?</strong> <a href="/om/kontakt/">Ta kontakt med FAU</a>.
          </p>
        )}
      </div>
    )
  }

  <div class="tekst">
    <Content />
  </div>

  {
    gruppe.data.logoer && gruppe.data.logoer.length > 0 && (
      <ul class="logoer">
        {gruppe.data.logoer.map((logo) => (
          <li>
            <img src={logo.fil} alt={logo.navn} loading="lazy" />
          </li>
        ))}
      </ul>
    )
  }

  {
    gruppe.data.bilder && gruppe.data.bilder.length > 0 && (
      <>
        <h2>Bilder</h2>
        <ul class="galleri">
          {gruppe.data.bilder.map((bilde) => (
            <li>
              <a href={bilde.fil}>
                <img src={bilde.fil} alt={bilde.tekst ?? ''} loading="lazy" />
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Side>
